# Fast localhost for testing. Run ./make_test, stop with ./make_test stop.
# Reuses targets from the main Makefile via sub-make.

HOST ?= localhost
PORT ?= 4500
TEST_SERVER_PORT ?= 4600
NOTEBOOK_LIST := make_test_notebooks.txt
NOTEBOOK_TEMPLATE := make_test_notebooks.template.txt
TEST_SERVER_LOG = /tmp/notebook_test_server$(TEST_SERVER_PORT).log
PYTHON := venv/bin/python3

SHELL = /bin/bash -c
.SHELLFLAGS = -e

MAIN_MAKE := $(MAKE) --no-print-directory -f Makefile
TEST_MAKE := $(MAKE) --no-print-directory -f Makefile.test

PROJECT_FILE := _projects/.makeprojects
ALL_PROJECTS := $(shell grep -v '^\#' $(PROJECT_FILE) 2>/dev/null | grep -v '^$$' | cut -d: -f1)

.DEFAULT_GOAL := make_test
.PHONY: make_test stop test-build-project-assets test-convert-required-notebooks test-notebook-list test-convert-listed-notebooks test-server test-stop-server

make_test: stop
	@$(MAIN_MAKE) clean
	@$(TEST_MAKE) test-build-project-assets
	@echo "Converting :dev project notebooks only..."
	@$(MAIN_MAKE) convert-registered-notebooks
	@$(TEST_MAKE) test-convert-required-notebooks
	@$(TEST_MAKE) test-convert-listed-notebooks
	@$(MAIN_MAKE) jekyll-serve HOST=$(HOST) PORT=$(PORT)
	@$(TEST_MAKE) test-server
	@echo ""
	@echo "Test server running on http://localhost:$(PORT)"
	@echo "  Compile a notebook: http://localhost:$(PORT)/notebook-tester/"
	@echo "  Jekyll logs:        tail -f /tmp/jekyll$(PORT).log"
	@echo "  Compiler logs:      tail -f $(TEST_SERVER_LOG)"
	@echo "  Stop:               ./make_test stop"

# `index`/`notebooks` only copy files; skipping project conversion is the speedup.
test-build-project-assets:
	@$(MAIN_MAKE) generate-makefiles >/dev/null
	@$(MAIN_MAKE) build-project-includes
	@for proj in $(ALL_PROJECTS); do \
		[ -d "_projects/$$proj" ] || continue; \
		echo "Copying assets: $$proj"; \
		$(MAKE) --no-print-directory -C "_projects/$$proj" index notebooks >/dev/null 2>&1 || echo "  ⚠️  Failed: $$proj"; \
	done
	@echo "Generating dynamic SASS imports..."
	@$(PYTHON) scripts/generate_sass_imports.py

# Reference pages crash Jekyll if their `lesson_category` has no posts.
test-convert-required-notebooks:
	@echo "Converting notebooks required for the site to build..."
	@$(PYTHON) scripts/required_test_notebooks.py | while read notebook; do \
		$(MAIN_MAKE) convert-single NOTEBOOK_FILE="$$notebook"; \
	done

# Personal list is gitignored; copy the template on first run (like _projects Makefiles).
test-notebook-list:
	@if [ ! -f $(NOTEBOOK_LIST) ]; then \
		echo "📋 Creating $(NOTEBOOK_LIST) (from template) - add your notebook paths there"; \
		cp $(NOTEBOOK_TEMPLATE) $(NOTEBOOK_LIST); \
	fi

test-convert-listed-notebooks: test-notebook-list
	@grep -v '^\s*#' $(NOTEBOOK_LIST) | grep -v '^\s*$$' | while read -r notebook; do \
		if [ -f "$$notebook" ]; then \
			$(MAIN_MAKE) convert-single NOTEBOOK_FILE="$$notebook"; \
		else \
			echo "⚠️  Not found (check $(NOTEBOOK_LIST)): $$notebook"; \
		fi; \
	done

test-server:
	@nohup $(PYTHON) scripts/notebook_test_server.py --port $(TEST_SERVER_PORT) --site-port $(PORT) > $(TEST_SERVER_LOG) 2>&1 &
	@for i in $$(seq 1 20); do \
		if curl -sf "http://127.0.0.1:$(TEST_SERVER_PORT)/api/health" >/dev/null; then \
			echo "Notebook compile server started on port $(TEST_SERVER_PORT)"; \
			exit 0; \
		fi; \
		sleep 0.5; \
	done; \
	echo "Compile server failed to start. Log:"; cat $(TEST_SERVER_LOG); exit 1

test-stop-server:
	@lsof -ti :$(TEST_SERVER_PORT) | xargs kill >/dev/null 2>&1 || true
	@rm -f $(TEST_SERVER_LOG)

stop: test-stop-server
	@$(MAIN_MAKE) stop PORT=$(PORT)

